---
import { getCollection } from 'astro:content';
import SiteShell from '../../layouts/SiteShell.astro';

const title = 'Blog · Legend of Mana Decompilation Project';
const description = 'Updates and notes from the lom-decomp project.';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL;
---
<SiteShell {title} {description} active="blog">
  <section class="content-panel blog-index" aria-labelledby="blog-title">
    <h2 id="blog-title" class="section-ribbon ribbon-blue">Project Blog</h2>
    <div class="blog-intro">
      <img src={`${base}images/icons/blog.webp`} alt="" width="140" height="140" />
      <div>
        <p>This is where project updates, discoveries, technical notes, and retrospectives can be found.</p>
      </div>
    </div>

    <div class="post-list">
      {posts.length === 0 ? (
        <p class="empty-state">No posts have been published yet.</p>
      ) : posts.map((post) => (
        <article class="post-card">
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
          <h3><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <a class="read-more" href={`${base}blog/${post.id}/`}>Read post →</a>
        </article>
      ))}
    </div>
  </section>
</SiteShell>
